generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Family {
  id        String         @id @default(cuid())
  name      String
  members   Member[]
  admins    FamilyAdmin[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Member {
  id              String         @id @default(cuid())
  firstName       String
  lastName        String?

  // Birthday stored as separate month/day for easy queries
  birthMonth      Int?           // 1-12
  birthDay        Int?           // 1-31

  occupation      String[]       // e.g. ["Teacher", "Engineer"]
  address         String[]       // physical addresses
  unit            String[]       // apartment/unit numbers
  phoneNumbers    String[]
  emails          String[]
  img             String?        // profile image URL

  familyId        String
  family          Family         @relation(fields: [familyId], references: [id], onDelete: Restrict)

  attendances                   Attendance[]
  workerTrainingAttendances     WorkerTrainingAttendance[]   // ✅ new relation
  adminOf                       FamilyAdmin[]

  lastAttendance  DateTime?
  lastTrainingAttendance DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([familyId])
  @@index([lastAttendance])
  @@index([birthMonth, birthDay])
}

model FamilyAdmin {
  id        String   @id @default(cuid())
  familyId  String
  memberId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([familyId, memberId])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attendance {
  id        String   @id @default(cuid())
  memberId  String
  date      DateTime // the service date
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, date])
  @@index([date])
  @@index([memberId])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 🔹 New model for worker training attendance
model WorkerTrainingAttendance {
  id        String   @id @default(cuid())
  memberId  String
  date      DateTime           // the training session date
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, date])   // a member can only be marked once per training day
  @@index([date])
  @@index([memberId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}